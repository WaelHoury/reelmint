# Pexels API (get key from https://www.pexels.com/api/)
PEXELS_API_KEY=your-pexels-api-key-here

# Video Settings
VIDEO_ORIENTATION=landscape  # Options: landscape (horizontal), portrait (vertical), square, any
ENABLE_SUBTITLES=true  # Enable/disable subtitles (true/false)
SUBTITLE_STYLE=youtube  # Options: youtube, tiktok, minimal
SUBTITLE_OFFSET=0.15  # Subtitle delay in seconds (only used if ASR unavailable)
WHISPER_MODEL=tiny  # ASR model for word timestamps: tiny, base, small, medium

# LLM Provider: "ollama" (local) or "openrouter" (cloud API)
LLM_PROVIDER=ollama
NARRATION_STYLE=viral  # Options: viral, informative, funny, storytelling, motivational, creative

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter Configuration (used when LLM_PROVIDER=openrouter)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TTS Configuration
TTS_ENGINE=kokoro  # Options: "piper", "kokoro", "orpheus", or "chatterbox"

# Piper TTS Configuration (if using Piper)
PIPER_MODEL_PATH=C:\projects\ai video maker\models\piper\en_US-lessac-medium.onnx
PIPER_EXECUTABLE=piper.exe

# Kokoro TTS Configuration (if using Kokoro)
KOKORO_VOICE=af_heart  # Options: af_heart (best female), af_bella, am_fenrir (best male), etc.
KOKORO_SPEED=1.0  # Range: 0.5-2.0 (1.0 = normal speed)
KOKORO_LANG=a  # Options: a (American), b (British), f (French), j (Japanese), etc.

# Orpheus TTS Configuration (if using Orpheus — uses orpheus-cpp / llama.cpp)
ORPHEUS_VOICE=tara  # Options: tara, leah, jess, leo, dan, mia, zac, zoe

# Chatterbox TTS Configuration (if using Chatterbox — 500M params, CUDA required)
CHATTERBOX_EXAGGERATION=0.5  # Emotion intensity (0.0-1.0, higher = more expressive)
CHATTERBOX_CFG=0.5           # Voice adherence (0.0-1.0)
CHATTERBOX_VOICE_REF=        # Path to WAV/MP3 reference audio for voice cloning (empty = default voice)
CHATTERBOX_BATCH_SIZE=4      # Sentences per batch (lower = more stable for long videos, slower)

# Narration Pacing
WORDS_PER_SECOND=           # Override words-per-second (empty = auto: 3.0 for kokoro, 2.5 for chatterbox)

# Video Loop Mode
ENABLE_VIDEO_LOOP=false  # Make video loop seamlessly (narration bridges back to start, last clip = first clip)
FADE_OUT_DURATION=1.0    # Fade-to-black at end of non-loop videos (0 to disable)

# Clip Search Performance
CLIP_SEARCH_WORKERS=6          # Parallel Pexels search threads (1-10, higher = faster clip generation)
CLIP_SEARCH_CACHE_TTL=21600    # Redis cache TTL for search results in seconds (default: 6 hours)

# OpenCLIP Configuration
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_CANDIDATES=3  # Number of video candidates to download and score (3-10, lower = faster)

# Working Directory
TEMP_DIR=C:\projects\ai video maker\temp
CACHE_DIR=C:\projects\ai video maker\cache
OUTPUT_DIR=C:\projects\ai video maker\output

# FFmpeg paths (optional, leave blank if in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# FFmpeg Encoding Performance
# Final output encoding (concat, finalize, effects)
FFMPEG_PRESET=fast              # Options: ultrafast, superfast, veryfast, fast, medium, slow
FFMPEG_CRF=25                   # Quality (0=lossless, 23=default, 25=good for social media, 51=worst)
FFMPEG_THREADS=4                # CPU threads for final encode (match worker CPU cores)
# Intermediate encoding (clip processing — re-encoded later, so speed > compression)
FFMPEG_INTERMEDIATE_PRESET=veryfast
FFMPEG_INTERMEDIATE_CRF=26     # Intermediate quality (re-encoded at final CRF, so high quality here is wasted)

# Video Effects Settings
TRANSITION_TYPE=crossfade  # Options: crossfade, dissolve, wipe, slide
TRANSITION_DURATION=0.5    # Duration in seconds (0.3-1.0 recommended)
VIDEO_OUTRO_DURATION=1.0   # Extra video duration after narration ends (seconds)

# Background Music Settings
ENABLE_BACKGROUND_MUSIC=true  # Enable/disable background music
MUSIC_DIR=music               # Directory containing music files
MUSIC_MOOD=auto               # Options: auto, energetic, calm, inspiring, neutral
MUSIC_VOLUME=0.15             # Music volume (0.1-0.3 recommended, 1.0 = same as narration)

# Multiple Clips Per Scene
ENABLE_MULTI_CLIPS=true  # Use multiple clips per scene (true/false)
CLIPS_PER_SCENE=2        # Default number of clips (1-4, or 'auto' for duration-based)

# Color Grading Settings
ENABLE_COLOR_GRADING=true       # Apply color grading (true/false)
COLOR_PRESET=balanced            # Options: balanced, warm, cool, vibrant, cinematic
CUSTOM_LUT_FILE=                 # Optional: path to custom LUT file (.cube format)

# Subscribe Overlay Settings
ENABLE_SUBSCRIBE_OVERLAY=false         # Show subscribe button animation (true/false)
SUBSCRIBE_VIDEO_PATH=subscribe.mp4     # Path to subscribe button video with green screen
SUBSCRIBE_SCALE=0.60                   # Scale relative to video width (0.1-0.8)
SUBSCRIBE_MARGIN_BOTTOM=50             # Pixels from bottom edge
SUBSCRIBE_CHROMAKEY_COLOR=0x60FA01     # Green screen color to key out (use eyedropper or ffprobe)
SUBSCRIBE_CHROMAKEY_SIMILARITY=0.25    # Color similarity (0.01-1.0, lower = stricter green match)
SUBSCRIBE_CHROMAKEY_BLEND=0.18         # Edge blend/smoothness (0.0-1.0)

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Auth & Security
# REQUIRED FOR DEPLOYMENT — app will refuse to start without a real secret in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=your-google-client-id

# Superuser emails (comma-separated) — exempt from per-user generation limits
SUPERUSER_EMAILS=

# Environment: "development" or "production"
# In production mode, JWT_SECRET_KEY must be changed from the default value.
ENVIRONMENT=development
