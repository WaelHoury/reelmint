# Pexels API (get key from https://www.pexels.com/api/)
PEXELS_API_KEY=

# Pixabay API (get key from https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
ENABLE_PIXABAY=false
ENABLE_IMAGE_FALLBACK=false

# Video Settings
VIDEO_ORIENTATION=landscape  # Options: landscape (horizontal), portrait (vertical), square, any
ENABLE_SUBTITLES=true  # Enable/disable subtitles (true/false)
SUBTITLE_STYLE=youtube  # Options: youtube, tiktok, minimal
SUBTITLE_OFFSET=0.15  # Subtitle delay in seconds (only used if ASR unavailable)
WHISPER_MODEL=base  # ASR model for word timestamps: tiny, base, small, medium
# Narration language for Whisper (e.g. en, fr); empty or auto = detect. Kokoro voices set it for you
WHISPER_LANGUAGE=

# LLM Provider (writes the script and picks the shots):
#   ollama      - local model, free, no key (default)
#   openrouter  - any model on openrouter.ai, needs OPENROUTER_API_KEY
#   anthropic   - Claude via the Anthropic API, needs ANTHROPIC_API_KEY
#   claude-code - Claude via your installed Claude Code CLI, uses its login
#                 (e.g. a Claude Pro/Max subscription), no API key
LLM_PROVIDER=ollama
NARRATION_STYLE=viral  # Options: viral, informative, funny, storytelling, motivational, creative
# Optional: how YOUR channel sounds, applied to every script. Makes your videos
# different from everyone else's using the same tool. Example:
# CHANNEL_VOICE=Dry British humour, short sentences, always one oddly specific detail per video.
CHANNEL_VOICE=

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter Configuration (used when LLM_PROVIDER=openrouter)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic API (used when LLM_PROVIDER=anthropic)
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium       # low, medium, high

# Claude Code CLI (used when LLM_PROVIDER=claude-code)
# Install from https://claude.com/claude-code and run `claude` once to log in.
CLAUDE_CODE_PATH=claude
# optional, e.g. sonnet or opus; empty = CLI default
CLAUDE_CODE_MODEL=

# TTS Configuration
# Voice engine when no provider/voice is chosen: kokoro or chatterbox.
# piper and orpheus work from the command line (generate_video.py) only.
TTS_ENGINE=kokoro  # Options: "kokoro", "chatterbox", "piper" (CLI only), "orpheus" (CLI only)

# Piper TTS Configuration (command line only, TTS_ENGINE=piper)
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_EXECUTABLE=piper  # Path to the piper binary; on Windows it defaults to piper.exe

# Kokoro TTS Configuration (if using Kokoro)
KOKORO_VOICE=af_heart  # Options: af_heart (best female), af_bella, am_fenrir (best male), etc.
KOKORO_SPEED=1.0  # Range: 0.5-2.0 (1.0 = normal speed)
KOKORO_LANG=a  # Fallback language; each voice's own language (af_ = American, ff_ = French, ...) is used automatically

# Orpheus TTS Configuration (if using Orpheus — uses orpheus-cpp / llama.cpp)
ORPHEUS_VOICE=tara  # Options: tara, leah, jess, leo, dan, mia, zac, zoe

# Chatterbox TTS Configuration (if using Chatterbox — 500M params, CUDA required)
CHATTERBOX_EXAGGERATION=0.5  # Emotion intensity (0.0-1.0, higher = more expressive)
CHATTERBOX_CFG=0.5           # Voice adherence (0.0-1.0)
# Path to WAV/MP3 reference audio for voice cloning (empty = default voice)
CHATTERBOX_VOICE_REF=
CHATTERBOX_BATCH_SIZE=4      # Sentences per batch (lower = more stable for long videos, slower)

# Provider-based TTS Configuration
TTS_ENABLED_PROVIDERS=kokoro         # Comma-separated: kokoro,chatterbox (fish is added automatically when FISH_AUDIO_API_KEY is set)
TTS_DEFAULT_PROVIDER=kokoro
TTS_DEFAULT_VOICE_KEY=kokoro:af_heart
TTS_PREVIEW_TEXT=Welcome to Reelmint. This is a preview of how your narration will sound.

# Fish Audio Configuration
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
# Optional extra Fish IDs pinned after the built-in starter/default voices
FISH_PRESET_VOICE_IDS=
FISH_PUBLIC_VOICES_ENABLED=false     # Keep false to show only Fish starter/default voices instead of community/public voices
FISH_PUBLIC_VOICE_PAGE_SIZE=24       # Number of public Fish voices to fetch into the catalog
FISH_PUBLIC_VOICE_PAGE_NUMBER=1
FISH_PUBLIC_VOICE_SORT_BY=score
FISH_PUBLIC_VOICE_CACHE_SECONDS=900
FISH_AUDIO_WORDS_PER_SECOND=3.0

# Narration Pacing
# Override words-per-second (empty = auto: 2.5 x KOKORO_SPEED for kokoro, 2.5 for chatterbox, FISH_AUDIO_WORDS_PER_SECOND for fish)
WORDS_PER_SECOND=

# Video Loop Mode
ENABLE_VIDEO_LOOP=false  # Make video loop seamlessly (narration bridges back to start, last clip = first clip)
FADE_OUT_DURATION=1.0    # Fade-to-black at end of non-loop videos (0 to disable)

# Clip Search Performance
# Shot pacing: seconds per stock clip. Fewer, longer shots = fewer downloads.
SECONDS_PER_CLIP=5             # 3 = fast TikTok-style cuts; videos over 60s use at least 6
CLIP_SEARCH_WORKERS=6          # Parallel Pexels search threads (1-10, higher = faster clip generation)
CLIP_SEARCH_CACHE_TTL=21600    # Redis cache TTL for search results in seconds (default: 6 hours)
DOWNLOAD_DEADLINE_SECONDS=180   # Give up on a stock clip download that takes longer (it retries / picks another)

# OpenCLIP Configuration
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_CANDIDATES=3  # Number of video candidates to download and score (3-10, lower = faster)

# Working Directory
TEMP_DIR=temp
CACHE_DIR=cache
OUTPUT_DIR=output
PROJECTS_DIR=projects          # Editor project files (one folder per rendered video)
TEMP_RETENTION_HOURS=48        # Delete render temp folders older than this

# FFmpeg paths (optional, leave blank if in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# FFmpeg Encoding Performance
# Final output encoding (concat, finalize, effects)
FFMPEG_PRESET=fast              # Options: ultrafast, superfast, veryfast, fast, medium, slow
FFMPEG_CRF=25                   # Quality (0=lossless, 23=default, 25=good for social media, 51=worst)
FFMPEG_THREADS=4                # CPU threads for final encode (match worker CPU cores)
# Intermediate encoding (clip processing — re-encoded later, so speed > compression)
FFMPEG_INTERMEDIATE_PRESET=veryfast
FFMPEG_INTERMEDIATE_CRF=26     # Intermediate quality (re-encoded at final CRF, so high quality here is wasted)

# Video Effects Settings
TRANSITION_TYPE=crossfade  # Options: crossfade, dissolve, wipe, slide
TRANSITION_DURATION=0.5    # Duration in seconds (0.3-1.0 recommended)
VIDEO_OUTRO_DURATION=1.0   # Extra video duration after narration ends (seconds)

# Background Music Settings
ENABLE_BACKGROUND_MUSIC=true  # Enable/disable background music
MUSIC_DIR=music               # Directory containing music files
MUSIC_MOOD=auto               # Options: auto, energetic, calm, inspiring, neutral
MUSIC_VOLUME=0.15             # Music volume (0.1-0.3 recommended, 1.0 = same as narration)

# Color Grading Settings
ENABLE_COLOR_GRADING=true       # Apply color grading (true/false)
COLOR_PRESET=balanced            # Options: balanced, warm, cool, vibrant, cinematic
# Optional: path to custom LUT file (.cube format)
CUSTOM_LUT_FILE=

# Subscribe Overlay Settings
ENABLE_SUBSCRIBE_OVERLAY=false         # Show subscribe button animation (true/false)
SUBSCRIBE_VIDEO_PATH=subscribe.mp4     # Path to subscribe button video with green screen
SUBSCRIBE_SCALE=0                      # Scale relative to video width (0.1-0.8); 0 = auto (0.60 landscape, 0.75 portrait, 0.65 square)
SUBSCRIBE_MARGIN_BOTTOM=50             # Pixels from bottom edge
SUBSCRIBE_CHROMAKEY_COLOR=0x60FA01     # Green screen color to key out (use eyedropper or ffprobe)
SUBSCRIBE_CHROMAKEY_SIMILARITY=0.25    # Color similarity (0.01-1.0, lower = stricter green match)
SUBSCRIBE_CHROMAKEY_BLEND=0.18         # Edge blend/smoothness (0.0-1.0)

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Environment: "development" or "production"
# In production mode, local video copies are deleted after a successful R2 upload.
ENVIRONMENT=development

# === Social Publishing ===
# Optional encryption key for storing OAuth tokens at rest. If empty, a key is
# generated on first use and saved to $CACHE_DIR/.social_token_key (keep that file;
# deleting it means reconnecting your accounts).
# To set your own: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Comma-separated enabled providers. Currently supported: youtube
SOCIAL_ENABLED_PROVIDERS=youtube

# YouTube OAuth for publishing (requires youtube.upload scope)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add YouTube Data API v3 to your project's enabled APIs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publish/oauth/youtube/callback
# Optional: your project's daily upload limit. Autopilot warns when a schedule would exceed it.
# Check YouTube Data API v3 quotas in the Google Cloud Console.
YOUTUBE_DAILY_UPLOAD_LIMIT=

# === Infrastructure (API + worker mode) ===
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+psycopg://reelmint:reelmint_dev@localhost:5432/reelmint
# Docker: password for the bundled Postgres (docker-compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=reelmint_dev
SESSION_TTL_HOURS=24           # How long an unfinished wizard session is kept in Redis

# API server (python run_api.py)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false               # true = auto-reload on code changes (development)

# === Cloudflare R2 storage (optional; videos stay on local disk when false) ===
USE_R2_STORAGE=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_EXPIRY_SECONDS=3600
